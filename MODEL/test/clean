import cv2
import numpy as np

def add_patch(image):
    h, w, _ = image.shape
    
    # random square patch
    patch_size = np.random.randint(30, 100)
    patch = np.random.randint(0, 255, (patch_size, patch_size, 3), dtype=np.uint8)
    
    x = np.random.randint(0, w - patch_size)
    y = np.random.randint(0, h - patch_size)
    
    image[y:y+patch_size, x:x+patch_size] = patch
    return image